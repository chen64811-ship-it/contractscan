# ============================================================
# ContractScan Configuration
# Copy this file to backend/.env and edit the values
#   cp .env.example backend/.env
# ============================================================

# ── Server ──
HOST=0.0.0.0
PORT=8000

# ── LLM API (Required — AI contract analysis) ──
LLM_API_KEY=your_api_key_here
LLM_API_BASE=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ── OCR (optional — for scanned PDF documents) ──
OCR_USE_GPU=true
OCR_LANG=en

# ── Rate Limiting (optional) ──
# Max file age: auto-delete uploads older than this (default: 86400 = 24h)
UPLOAD_MAX_AGE=86400

# ── Unlock Codes ──
# Comma-separated. Single-use by default.
# Prefix with * for multi-use codes (e.g. *ADMIN2026)
UNLOCK_CODES=TRIAL2026,DEMO2026,*ADMIN2026

# ── Payment Links (optional) ──
# Replace with your actual payment URLs (Lemon Squeezy, Stripe, etc.)
PAYMENT_SINGLE_URL=
PAYMENT_PRO_URL=
