# ============================================================
# ContractScan Configuration
# Copy this file to backend/.env and edit the values
#   cp .env.example backend/.env
# ============================================================

# ── Server ──
HOST=0.0.0.0
PORT=8000

# ── LLM API (Required — AI contract analysis) ──
LLM_API_KEY=your_api_key_here
LLM_API_BASE=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ── OCR (optional — for scanned PDF documents) ──
OCR_USE_GPU=true
OCR_LANG=en

# ── Rate Limiting (optional) ──
# Max file age: auto-delete uploads older than this (default: 86400 = 24h)
UPLOAD_MAX_AGE=86400

# ── Unlock Codes (optional) ──
# Comma-separated. Single-use by default.
# Prefix with * for multi-use codes (e.g. *ADMIN2026)
UNLOCK_CODES=TRIAL2026,DEMO2026,*ADMIN2026

# ── Admin ──
ADMIN_KEY=change-me-to-a-random-string

# ── Payment Links — Lemon Squeezy ──
# 1. Create products at https://app.lemonsqueezy.com/products
# 2. Get checkout URLs from each product's "Share" tab
# 3. Paste the direct checkout URLs below

# Single Report ($4.99 one-time)
PAYMENT_SINGLE_URL=https://contractscan.lemonsqueezy.com/checkout/buy/...

# Pro Monthly ($29/mo subscription)
PAYMENT_PRO_URL=https://contractscan.lemonsqueezy.com/checkout/buy/...

# ── Lemon Squeezy Webhook ──
# 1. Go to https://app.lemonsqueezy.com/settings/webhooks
# 2. Add webhook URL: https://your-domain.com/api/payment/webhook
# 3. Copy the signing secret below
LEMON_SQUEEZY_WEBHOOK_SECRET=
