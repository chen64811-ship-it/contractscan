# ============================================================
# ContractScan Configuration
# Copy this file to backend/.env and edit the values
#   cp .env.example backend/.env
# ============================================================

# ── Server ──
HOST=0.0.0.0
PORT=8000

# ── LLM API (Required — AI contract analysis) ──
LLM_API_KEY=your_api_key_here
LLM_API_BASE=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ── OCR (optional — for scanned PDF documents) ──
OCR_USE_GPU=true
OCR_LANG=en
