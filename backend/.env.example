# ContractScan backend .env example
# Copy to backend/.env and edit values before running

# LLM / DeepSeek API
LLM_API_KEY=your_deepseek_api_key
LLM_API_BASE=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Database (SQLAlchemy URL)
# Example for docker-compose MySQL service
DATABASE_URL=mysql+pymysql://contract_user:contract_pass@mysql:3306/contractscan

# Uploads / outputs
UPLOAD_FOLDER=uploads
OUTPUT_FOLDER=outputs

# OCR
OCR_USE_GPU=true
OCR_LANG=en

# Unlock codes (comma separated). Prefix with * for multi-use codes
UNLOCK_CODES=TRIAL2026,DEMO2026

# Admin key for listing codes
ADMIN_KEY=changeme

# Lemon Squeezy webhook secret (if using Lemon Squeezy)
LEMON_SQUEEZY_WEBHOOK_SECRET=

# Other
HOST=0.0.0.0
PORT=8000
UPLOAD_MAX_AGE=86400

# MySQL credentials used by backup/restore scripts
MYSQL_USER=contract_user
MYSQL_PASSWORD=contract_pass
MYSQL_DATABASE=contractscan

